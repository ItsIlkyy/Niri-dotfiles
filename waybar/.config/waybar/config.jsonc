{
  "layer": "top",
  "position": "left",
  "reload_style_on_change": true,
  "width": 52,
  "style": "~/.config/waybar/style.css",
  "margin-left": 0,
  "margin-right": 0,
  "margin-top": 0,
  "margin-bottom": 0,
  "spacing": 0,
  "gtk-layer-shell": true,
  "output": ["HDMI-A-1", "eDP-1"],


  "modules-left": [
    "clock#time",
    "clock#date",
    "custom/tuned"
  ],

  "modules-center": [
      "custom/visualizer"
  ],

  "modules-right": [
    "wireplumber",
    "backlight",
    //"bluetooth",
    "network",
    "battery"
  ],

  "custom/power": {
    "format": " 󰤆 ",
    "on-click": "wleave",
    "tooltip": false
  },

"custom/tuned": {
    "format": "{}",
    "return-type": "json",
    "interval": 10,
    "signal": 8,
    "exec": "~/.config/waybar/scripts/tuned.sh",
    "on-click": "~/.config/waybar/scripts/tuned.sh toggle && pkill -RTMIN+8 waybar",
    "justify": "center",
    "tooltip": true
},

"clock#time": {
  "format": "󰥔\n{:%I\n%M}", 
  "justify": "center",
  "tooltip": false
},

"clock#date": {
  "format": "󰃭\n{:%d\n%m}", 
  "justify": "center",
  "tooltip": false
},

  "battery": {
    "states": {
      "good": 60,
      "warning": 30,
      "critical": 15
    },


    "justify": "center",
    "format": "{icon}\n{capacity}",
    "format-alt": "{icon}",
    "format-charging": "󰂄\n{capacity}",
    "format-icons": ["󰂎","󰁺","󰁻","󰁼","󰁽","󰁾","󰁿","󰂀","󰂁","󰂂","󰁹"],
    "tooltip": false
  },

  "network": {
    "format-wifi": " {icon}",
    "format-ethernet": "󰈀",
    "format-icons": ["󰤯 ", "󰤟 ", "󰤢 ", "󰤨 "],
    "format-disconnected": "󰪎",
    "on-click": "kitty -e nmtui",
    "interval": 3,
    "tooltip": false
  },

  "bluetooth": {
    "format": "{icon}",
    "format-icons": ["", "󰤾", "󰥀", "󰥄", "󰥈"],
    "format-connected-battery": "󰋋",
    "tooltip": false,
    "on-click": "blueman-manager"
  },

  "backlight": {
    "device": "intel_backlight",
    "format": "{icon}",
    "justify": "center",
    "format-alt": "{icon}\n{percent}",
    "format-icons": ["", "", "", "", "", "", "", "", ""],
    "tooltip": false,
    "on-click-right": "~/.config/waybar/scripts/sunset-toggle.sh"
  },

  "wireplumber": {
    "format": "{icon}",
    "format-alt": "{icon}\n{volume}",
    "format-icons": ["","󰪞","󰪟","󰪠","󰪡","󰪢","󰪣","󰪤","󰪥"],
    "format-muted": "",
    "max-volume": 99,
    "justify": "center",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-middle": "blueman-manager"
  },

  "custom/visualizer": {
    "format": "{}",
    "rotate": 270,
    "exec": "~/.config/waybar/scripts/cava.sh",
    "tooltip": false
  }

}

